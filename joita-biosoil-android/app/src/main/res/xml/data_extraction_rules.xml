<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="joita_soil.db" />
        <exclude domain="database" path="joita_collective.db" />
        <exclude domain="file" path="field-photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="joita_soil.db" />
        <include domain="database" path="joita_collective.db" />
        <include domain="file" path="field-photos/" />
    </device-transfer>
</data-extraction-rules>
